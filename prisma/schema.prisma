generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BetStatus {
  PENDING
  CONFIRMED
  REJECTED
  SETTLED_WIN
  SETTLED_LOSS
  VOID
}

// Stage 1 of the Bet -> Bet + BetSelection migration (see README "What's not
// done yet" / parlay research). Purely additive: existing single-event bets
// keep working unchanged via the old sport/event/outcome/odds fields below,
// which are NOT removed yet.
//
// Stage 12 — PARLAY renamed to EXPRESS (0 rows used this value in
// production at the time of the rename, verified directly against the
// database before migrating, not just against local schema state).
enum BetType {
  SINGLE
  EXPRESS
}

// Stage 12 — per-selection odds-verification outcome. PENDING is the
// column default but isn't actually reachable by any current code path:
// odds are always verified synchronously before a previewToken is signed,
// so a selection is created already carrying one of the other four values.
// Reserved for a possible future async/re-verification stage.
enum BetSelectionOddsStatus {
  PENDING
  VERIFIED
  ODDS_CHANGED
  NOT_FOUND
  UNAVAILABLE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  ADJUSTMENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Operator {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  // Stage 5.0B — nullable so existing rows (e.g. seed.ts's TEST_OPERATOR_PHONE)
  // migrate cleanly with no password set yet; scripts/create-operator.ts is
  // the only intended way to set/update this.
  passwordHash String?
  createdAt    DateTime @default(now())

  players  Player[]
  sessions OperatorSession[]
}

// Stage 5.0B — database-backed operator login sessions. The DB stores only
// tokenHash (SHA-256 of the raw session token); the raw token itself exists
// only in the operator's browser cookie and is never persisted anywhere. See
// docs/OPERATOR_AUTH_IMPLEMENTATION.md for the full session lifecycle.
model OperatorSession {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([operatorId])
  @@index([expiresAt])
}

model Player {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  name             String
  telegramId       String?  @unique
  // Closed-demo onboarding — set once when a player is invited (before they
  // ever open the bot), matched against Telegram's own from.username on
  // their first /start, then never consulted again for authentication.
  // Always stored normalized (no leading "@", lowercase) — see
  // lib/telegram/bindInvitedPlayer.ts. NOT an auth credential: Mini App
  // access (GET /api/miniapp/me) continues to check signed initData's
  // user.id against telegramId exclusively, never this field.
  telegramUsername String?  @unique
  phoneNumber      String?
  createdAt        DateTime @default(now())

  creditLimit   Decimal @default(10000) @db.Decimal(18, 6)
  currentCredit Decimal @default(0) @db.Decimal(18, 6) // + player is up, - player owes

  wallet                 Wallet?
  bets                   Bet[]
  messages               Message[]
  transactions           Transaction[]
  // Stage 4.2B3
  screenshotRecognitions ScreenshotRecognition[]

  @@index([operatorId])
}

model Wallet {
  id       String @id @default(cuid())
  playerId String @unique
  player   Player @relation(fields: [playerId], references: [id])

  balance   Decimal  @default(0) @db.Decimal(18, 6) // USDC
  updatedAt DateTime @updatedAt
}

model Bet {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  // Transitional single-event fields — still the source of truth for every
  // existing bet today. Not removed in Stage 1; see README for the planned
  // backfill (Stage 2) before these are ever dropped.
  //
  // Stage 12 — event/outcome made nullable: an EXPRESS bet has no single
  // event/outcome of its own (that detail now lives per-leg on
  // BetSelection). Existing SINGLE rows are unaffected — this is a
  // widening, not a data change.
  sport   String
  event   String?
  outcome String?
  odds    Decimal? @db.Decimal(6, 2)
  stake   Decimal  @db.Decimal(18, 6) // USDC

  // Stage 1 additions for express/parlay support. `type` defaults to SINGLE
  // so every existing row is valid without a backfill; `totalOdds` is
  // nullable and unused until something actually populates it for an
  // EXPRESS bet.
  type       BetType        @default(SINGLE)
  totalOdds  Decimal?       @db.Decimal(10, 2)
  selections BetSelection[]

  // Stage 4.4A idempotency key for Mini App text-bet confirm: the previewId
  // from a verified, short-lived signed preview token (see
  // lib/betPreview/previewToken.ts). Nullable — only confirm-created bets
  // set it; every other creation path (operator dashboard, WhatsApp-era
  // betService.ts) leaves it null. The unique constraint is what actually
  // prevents a double-submit/race from creating two Bets, not the
  // pre-insert lookup in the confirm route.
  previewId String? @unique

  status     BetStatus @default(PENDING)
  rawMessage String? // исходный текст от игрока

  oddsSnapshot OddsSnapshot?
  transactions Transaction[]

  // Stage 3.1 — provider event references for SINGLE (Variant B: SINGLE has
  // no BetSelection row today, so its provider metadata lives here instead;
  // EXPRESS's equivalent fields live on BetSelection below). All nullable —
  // only ever populated when the odds provider unambiguously resolved the
  // matched event at verification time (see lib/odds/oddsVerifier.ts's
  // extractProviderEventMetadata); never fabricated, never backfilled by
  // fuzzy re-matching. Not used by any settlement/display code yet — purely
  // additive persistence, laying the groundwork for a future automatic
  // settlement stage.
  providerName           String?
  providerEventId        String?
  providerSportKey       String?
  eventStartTime         DateTime?
  canonicalMarketType    String?
  canonicalSelectionType String?
  canonicalParticipant   String?
  canonicalPeriod        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
  @@index([status])
}

// New in Stage 1 — not yet populated or read by any application code. A
// future stage will backfill one BetSelection per existing single Bet, then
// switch API/UI consumers over, then (much later) drop Bet's own
// sport/event/outcome/odds fields. No BetSelection-level status yet — bet
// results are still tracked only on Bet.status for now.
//
// Stage 12 — `outcome` and `odds` are intentionally NOT renamed even though
// they're now understood as "selection" and "submittedOdds" respectively:
// both already have real backfilled data and existing readers
// (BetSelectionsList.tsx, BetTicket.tsx, serialize.ts). A physical rename is
// a separate, later cleanup once every consumer is ready to move together.
model BetSelection {
  id    String @id @default(cuid())
  betId String
  bet   Bet    @relation(fields: [betId], references: [id], onDelete: Cascade)

  sport   String
  event   String
  outcome String
  odds    Decimal? @db.Decimal(6, 2)

  // Stage 12 additions for EXPRESS support — all additive, nullable/defaulted,
  // don't affect any already-backfilled row's meaning.
  market      String?
  currentOdds Decimal?               @db.Decimal(6, 2)
  oddsStatus  BetSelectionOddsStatus @default(PENDING)

  // Stage 3.1 — provider event references, one set per EXPRESS leg (Variant
  // B: mirrors the same field set added to Bet above, for SINGLE). Same
  // nullable, additive, never-fabricated semantics — see Bet's own comment
  // above for the full rationale.
  providerName           String?
  providerEventId        String?
  providerSportKey       String?
  eventStartTime         DateTime?
  canonicalMarketType    String?
  canonicalSelectionType String?
  canonicalParticipant   String?
  canonicalPeriod        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([betId])
}

model OddsSnapshot {
  id    String @id @default(cuid())
  betId String @unique
  bet   Bet    @relation(fields: [betId], references: [id])

  sourceOdds    Decimal? @db.Decimal(6, 2)
  submittedOdds Decimal  @db.Decimal(6, 2)
  matched       Boolean
  checkedAt     DateTime @default(now())
}

model Transaction {
  id       String  @id @default(cuid())
  playerId String
  player   Player  @relation(fields: [playerId], references: [id])
  betId    String?
  bet      Bet?    @relation(fields: [betId], references: [id])

  type         TransactionType
  amount       Decimal         @db.Decimal(18, 6)
  balanceAfter Decimal         @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@index([playerId])
}

model Message {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  direction MessageDirection
  content   String
  betId     String?

  createdAt DateTime @default(now())

  @@index([playerId])
}

// Stage 4.2B3 — the immutable half of the screenshot pipeline's
// recognition/verification split (Stage 4.2A's own architecture verdict).
// Represents "what OCR + the AI parser read from this exact image", scoped
// per player (same isolation convention as every other model here — two
// different players uploading byte-identical bytes get two separate rows,
// never a cross-player cache hit). Never updated after creation: no code
// path calls `update` on this model. imageHash is lib/ocr/imageHash.ts's
// SHA-256 of the raw, unprocessed bytes (Stage 4.2B2) — the identity key
// that lets a repeat upload skip OCR/the AI parser entirely.
//
// @@unique([playerId, imageHash]) is also this model's concurrency guard:
// two simultaneous uploads of the same image by the same player both
// attempt to `create`; the database — not application code — guarantees
// only one row ever exists, and the loser's create() throws P2025/P2002,
// which the service layer catches and re-reads instead of erroring.
model ScreenshotRecognition {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  imageHash String

  // The exact lib/bets/betSlip.ts ParsedBetSlip shape ({ type, stake,
  // selections }) the AI parser produced — never re-derived, never
  // normalized further here. Storing the whole structure as one JSON value
  // (rather than separate typed columns) keeps this model minimal and
  // avoids inventing a second, parallel column-based encoding of a shape
  // that already exists as a TypeScript type.
  parsedBet Json

  // The OCR-normalized text this recognition was built from — diagnostic
  // only (mirrors what the operator debug route already returns directly in
  // its own HTTP response), never read by any decision-making code.
  // Nullable so a future recognition source that skips OCR entirely (none
  // exists today) isn't forced to fabricate a value.
  ocrText String?

  createdAt DateTime @default(now())

  verifications ScreenshotVerification[]

  @@unique([playerId, imageHash])
  @@index([playerId])
}

// Stage 4.2B3 — the versioned, time-dependent half: one row per odds
// verification pass against an (immutable) ScreenshotRecognition. Never
// updated after creation either — a re-check (TTL expiry or an explicit
// Refresh Odds request) always creates a NEW row rather than mutating an
// old one, so "what did the odds look like at time T" stays a real,
// reconstructable fact rather than being overwritten in place.
model ScreenshotVerification {
  id            String                @id @default(cuid())
  recognitionId String
  recognition   ScreenshotRecognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)

  // The exact lib/bets/buildBetSlipPreview.ts BetSlipPreview shape — same
  // "store the existing TypeScript shape as JSON" choice as
  // ScreenshotRecognition.parsedBet, for the same reason.
  preview Json

  // buildBetSlipPreview()'s own signed token for this exact preview
  // snapshot — reused as-is (never re-signed) whenever this verification
  // row is served from cache, so "same verification version" also means
  // "same token", never a fresh one minted for identical content. Nullable
  // for the same reason buildBetSlipPreview.ts's own previewToken already
  // is: an EXPRESS with any leg's odds still unknown signs no token at all.
  previewToken String?

  createdAt DateTime @default(now())
  // TTL boundary (lib/bets/screenshotRecognitionService.ts's
  // VERIFICATION_TTL_MS) — a verification is only ever reused while
  // `expiresAt > now`; past that, the next preview request creates a fresh
  // row rather than serving stale odds indefinitely.
  expiresAt DateTime

  @@index([recognitionId, createdAt])
}
