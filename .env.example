# Neon Postgres connection string (pooled endpoint recommended for serverless/Vercel).
# Get it from: Neon Console → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# AI provider used by lib/ai/betParser.ts to parse incoming bet messages.
# "ollama" (default) — local Ollama chat API, no key required.
# "claude" — Anthropic API, requires ANTHROPIC_API_KEY below.
AI_PROVIDER="ollama"

# Local Ollama server. Only used when AI_PROVIDER="ollama".
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Anthropic API key. Only required when AI_PROVIDER="claude".
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# The Odds API key for live odds verification (lib/odds/oddsVerifier.ts).
# Get it from: https://the-odds-api.com/ → Account
ODDS_API_KEY="your-odds-api-key"

# Stage 10 — Sportmonks Football API v3 token (second provider, football
# vertical slice). Requires the "Odds & Predictions" add-on for pre-match
# 1X2 odds. Get it from: my.sportmonks.com → Football API.
SPORTMONKS_API_TOKEN="your-sportmonks-api-token"

# Stage 10 — enables the Sportmonks football preview path in
# POST /api/miniapp/bets/text/preview (lib/bets/buildSportmonksFootballPreview.ts).
# Set to exactly "true" to enable; any other value (including unset) keeps
# the existing The Odds API pipeline fully unchanged for every sport.
SPORTMONKS_FOOTBALL_PREVIEW_ENABLED=

# Bearer token operators must send to call /api/bets/* endpoints
# (Authorization: Bearer <value>). Any random string works locally —
# it's not used for cryptographic signing, just shared-secret comparison.
OPERATOR_SECRET="replace-with-a-random-string"

# Bearer token required to call the internal automatic-settlement polling
# trigger (Authorization: Bearer <value>, lib/auth/cronAuth.ts,
# app/api/internal/poll-results/route.ts — Stage 3.5B1). Must be its own
# separate random secret — never reuse OPERATOR_SECRET or any other secret
# in this file. Server-side only: never expose this to client-side code or
# a NEXT_PUBLIC_ env var. As of Stage 3.5B1 no scheduler calls this route
# automatically yet — it must still be triggered manually (Stage 3.5B2 will
# wire up Vercel Cron once verified).
CRON_SECRET="replace-with-a-different-random-string"

# Controls bet-lifecycle status notifications to players (confirmed /
# rejected / settled win-loss-void — lib/telegram/betStatusNotifications.ts).
# Temporarily disabled by default: set to exactly "true" to re-enable; any
# other value (including unset, empty, or wrong case) stays disabled. Does
# NOT affect the bot's interactive dialog (welcome, /odds, screenshot OCR
# replies), which always keeps working regardless of this flag.
BET_TELEGRAM_NOTIFICATIONS_ENABLED=

# Stage 9.1 — enables the read-only /find command (Event Discovery Engine
# Candidate Resolver, lib/telegram/discoveryCommand.ts). Set to exactly
# "true" to enable; any other value (including unset) keeps /find disabled
# and falls through to the existing generic redirect, unchanged. Read-only:
# never calls /odds, never creates a Bet/Preview, never touches balance.
TELEGRAM_DISCOVERY_READ_ONLY_ENABLED=

# Telegram bot token for the webhook (lib/telegram/sendMessage.ts,
# app/api/webhooks/telegram/route.ts).
# Get it from: message @BotFather on Telegram → /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."

# Secret token Telegram sends back in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook request, checked by lib/auth/telegramWebhookAuth.ts.
# This is the same value passed as secret_token when calling Telegram's
# setWebhook API — any random string works.
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-secret"

# HMAC secret used to sign/verify the short-lived text-bet preview token
# (lib/betPreview/previewToken.ts). Any random string works — not shared
# with TELEGRAM_BOT_TOKEN or any other secret.
BET_PREVIEW_TOKEN_SECRET=

# Operator dashboard session lifetime, in hours (Stage 5.0B,
# lib/auth/operatorSession.ts). Optional — defaults to 12 if unset or not a
# positive number.
OPERATOR_SESSION_TTL_HOURS=12

# Name of the operator session cookie (Stage 5.0B). Optional — defaults to
# "betpilot_operator_session" if unset. Change only if it collides with
# something else in your deployment.
OPERATOR_SESSION_COOKIE_NAME=betpilot_operator_session
